---
import WidgetWrapper from "./WidgetWrapper.astro";
import type { FeaturesProps } from "@/types/types";
import Card from "@/components/ui/Card.astro";
import Headline from "@/components/ui/Headline.astro";
import { Image } from "astro:assets";

const {
  features = [],
  title,
  subtitle,
  tagline,
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render("bg"),
} = Astro.props as FeaturesProps;

const {
  container: containerClassProp = "",
  grid: gridClassProp = "grid-cols-1 md:grid-cols-3",
  card: cardClassProp = "",
  ...otherClasses
} = classes;
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={` ${containerClassProp}`}
  bg={bg}
  classes={otherClasses}
>
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={{
      container: "max-w-3xl mx-auto text-center",
    }}
  />
  <div class={`grid ${gridClassProp} gap-8`}>
    {
      features.map((feature) => {
        const IconComponent = feature.icon;
        const image = feature.image;
        const imageAlt = feature.imageAlt;
        const centerIcon = feature.centerIcon || false;

        return (
          <Card cardPadding={image ? "p-0" : "p-8"} class={`${cardClassProp}`}>
            {image && imageAlt && (
              <div class="w-full aspect-[6/3] rounded-t-lg overflow-hidden mb-2">
                <Image
                  src={image}
                  alt={imageAlt}
                  class="w-full h-full object-cover"
                />
              </div>
            )}
            {!image && IconComponent && (
              <div
                class={`w-12 h-12 rounded-lg flex items-center justify-center mb-6 ${centerIcon ? "mx-auto" : ""} ${feature.iconClass ? feature.iconClass : "bg-primary/10 text-primary"}`}
              >
                <IconComponent class="w-6 h-6" />
              </div>
            )}
            <div class={image ? "p-4" : "p-0"}>
              <h3 class="text-xl font-bold text-foreground mb-3">
                {feature.title}
              </h3>
              <p class="text-muted-foreground text-sm">{feature.description}</p>
            </div>
          </Card>
        );
      })
    }
  </div>
</WidgetWrapper>
