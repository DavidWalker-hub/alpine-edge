---
interface Props {
  class?: string;
  href?: string;
  cardPadding?: string;
}

const { class: className, href, cardPadding = "p-8", ...rest } = Astro.props;

const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class:list={[
    `bg-card ${cardPadding} rounded-2xl border border-border shadow-sm transition-all duration-200 hover:shadow-md hover:scale-[1.01] hover:-translate-y-1`,
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
