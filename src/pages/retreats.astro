---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Pricing from "@/components/widgets/Pricing.astro";
import Content from "@/components/widgets/Content.astro";
import Content2 from "@/components/widgets/Content2.astro";
import TravelIcon from "@/components/icons/TravelIcon.astro";
import SkiIcon from "@/components/icons/SkiIcon.astro";
import HouseIcon from "@/components/icons/HouseIcon.astro";
import VanIcon from "@/components/icons/VanIcon.astro";
import ChefIcon from "@/components/icons/ChefIcon.astro";
import UserGroupIcon from "@/components/icons/UserGroupIcon.astro";
import WellnessIcon from "@/components/icons/WellnessIcon.astro";
import LaptopVideoIcon from "@/components/icons/LaptopVideoIcon.astro";
import CameraIcon from "@/components/icons/CameraIcon.astro";
import YogaIcon from "@/components/icons/YogaIcon.astro";
import UserSingleIcon from "@/components/icons/UserSingleIcon.astro";
import UserMultipleIcon from "@/components/icons/UserMultipleIcon.astro";
import yseRoom from "@/assets/images/accom/yseRoom.jpg";
import Features from "@/components/widgets/Features.astro";

const roomOptions = [
  {
    title: "Standard",
    roomType: "Shared Twin or Double Room",
    description:
      "A shared room with one other guest, with a choice of twin or double bed.",
    price: "£5,650",
    icon: UserMultipleIcon,
  },
  {
    title: "Private",
    roomType: "Private Room",
    description: "A spacious room with premium amenities and stunning views.",
    price: "£6,250",
    icon: UserSingleIcon,
  },
];

const features = [
  {
    description: "6 Days Expert Ski Coaching",
    icon: SkiIcon,
    iconClass: "bg-card text-primary",
    centerIcon: true,
  },
  {
    description: "7 Nights Luxury Chalet Accommodation",
    icon: HouseIcon,
    iconClass: "bg-card text-primary",
    centerIcon: true,
  },
  {
    description: "Airport Transfers",
    icon: VanIcon,
    iconClass: "bg-card text-primary",
    centerIcon: true,
  },
  {
    description: "Breakfast, Afternoon Tea and Evening Meals",
    icon: ChefIcon,
    iconClass: "bg-card text-primary",
    centerIcon: true,
  },
  {
    description: "Small Group Coaching Max 5 Skiers",
    icon: UserGroupIcon,
    iconClass: "bg-card text-primary",
    centerIcon: true,
  },
  {
    description: "Sauna, Ice Bath and Jacuzzi",
    icon: WellnessIcon,
    iconClass: "bg-card text-primary",
    centerIcon: true,
  },
  {
    description: "Stretching and Mobility Sessions",
    icon: YogaIcon,
    iconClass: "bg-card text-primary",
    centerIcon: true,
  },
  {
    description: "Video Analysis from Your Coach",
    icon: LaptopVideoIcon,
    iconClass: "bg-card text-primary",
    centerIcon: true,
  },
  {
    description: "Professional Photography and Video",
    icon: CameraIcon,
    iconClass: "bg-card text-primary",
    centerIcon: true,
  },
  {
    description: "6 Day Ski Pass",
    icon: TravelIcon,
    iconClass: "bg-card text-primary",
    centerIcon: true,
  },
];

const metadata = {
  title: "Retreats",
  description:
    "Discover more about our ski retreats, whats included and what options are available to you.",
};
---

<BaseLayout {metadata}>
  <Content
    tagline="Retreats"
    title="Our Retreats"
    description={[
      "Discover more about our ski retreats, whats included and what options are available to you.",
    ]}
  />
  <Content2
    tagline="Upcoming Retreats"
    title="Winter 2026 - 2027"
    description={[
      "Alpine Edge is excited to announce our retreat for the 26 -27 winter season will take place in Val d'Isère, France. The retreat will run from the 7th - 14th of February 2027, staying in the beautiful Chalet Isère.",
    ]}
    image={yseRoom}
    imageAlt="One of the bedrooms in the chalet Isère in the french ski resort of Val d'Isere"
  />
  <Pricing
    tagline="options"
    roomOptions={roomOptions}
    title="Investment"
    description={["Choose the accommodation option that best suits your stay."]}
  />
  <Features
    tagline="Included"
    title="Every Booking Includes"
    classes={{ grid: "grid-cols-2 md:grid-cols-4", card: "text-center" }}
    features={features}
  />
</BaseLayout>
