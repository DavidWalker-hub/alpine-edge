---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import Hero from "@/components/widgets/Hero.astro";
import Features from "@/components/widgets/Features.astro";
import carvingImg from "@/assets/images/skiing/carving2DW.jpg";
import Content2 from "@/components/widgets/Content2.astro";
import powderSprayImage from "@/assets/images/powderSpray.jpg";
import accom1 from "@/assets/images/accom/accom1.webp";
const metadata = {
  title: `${siteConfig.name} — The ski and wellness retreat.`,
  description:
    "A ski and wellness retreat designed to help you reach your potential on the mountain. Join us for a week of expert coaching, luxury accommodation and apres ski designed to maximise your performance.",
  ignoreTitleTemplate: true,
};
---

<BaseLayout {metadata}>
  <Hero
    title={`<span class="text-primary">Alpine Edge</span> 
    `}
    description={`<span class="text-secondary">${siteConfig.description}</span>`}
    image={powderSprayImage}
    imageAlt="landinng page hero image of a skier spraying powder"
    classes={{
      container:
        "-mt-5 -mb-60 sm:mt-20 md:-mt-20 md:-mb-50 lg:-mt-20 lg:mb-0 xl:mb-70",
    }}
  />
  <Features
    tagline="About us"
    title="What is Alpine Edge?"
    subtitle="Alpine Edge is designed for people seeking to take their skiing to the highest level."
    features={[
      {
        title: "Ski clinics",
        description:
          "Professional ski instruction from instructors with the highest certification.",
        icon: "hugeicons:ski",
        iconClass: "bg-blue-500/10 text-blue-400",
      },
      {
        title: "Luxury accommodation",
        description:
          "Stay in the most luxurious chalets complete with spa and gourmet dining.",
        icon: "hugeicons:house-03",
        iconClass: "bg-teal-500/10 text-teal-400",
      },
      {
        title: "Après-ski reimagined",
        description:
          "Apres ski designed to maximise your performance includes video feedback sessions, sauna & ice bath and stretching.",
        icon: "hugeicons:wellness",
        iconClass: "bg-pink-500/10 text-pink-400",
      },
    ]}
  />
  <Content2
    items={[
      {
        title: "Coaches",
        description:
          "Our coaches have obtained the highest level of ski instruction through the BASI system. With over two decades of combined experience, they have honed their skills and are passionate about sharing their knowledge.",
        icon: "hugeicons:ski",
        iconClass: "bg-blue-500/10 text-blue-400",
      },
      {
        title: "Groups",
        description:
          "With a maximum of 5 in a group, you will receive personalised instruction tailored to your needs and plenty of time to practice.",
        icon: "hugeicons:user-group",
        iconClass: "bg-teal-500/10 text-teal-400",
      },
      {
        title: "Off mountain activities",
        description:
          "After a day on the slopes, we focus on recovery and preparation for the next day. Video analysis sessions ensure everyone has a complete understanding of the techniques covered, while our spa facilities including sauna and ice bath help you recover and prepare for the next day. We also include stretching sessions to improve mobility, promote recovery and prevent injury.",
        icon: "hugeicons:wellness",
        iconClass: "bg-pink-500/10 text-pink-400",
      },
    ]}
    image={carvingImg}
    imageAlt="Image of a skier carving a turn in the snow, showcasing precision and control."
  >
    <Fragment>
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">
        Improve your skiing
      </h3>
      Every aspect of Alpine Edge is carefully curated to help you reach your potential.
    </Fragment>
  </Content2>
  <Content2
    items={[
      {
        title: "Rooms",
        description:
          "We offer a variety of packages allowing you to choose from a private room or to share. All maintain the same high standard of comfort and luxury with a gorgeous mountain view",
        icon: "hugeicons:bed-double",
        iconClass: "bg-indigo-500/10 text-indigo-400",
      },
      {
        title: "Chef",
        description:
          "A private chef will prepare delicious meals to fuel your day on the mountain. We cater to all dietary requirements and preferences, ensuring you have the energy you need to perform at your best.",
        icon: "hugeicons:chef",
        iconClass: "bg-teal-500/10 text-teal-400",
      },
      {
        title: "Spa",
        description:
          "After a day on the mountain, relax and unwind in the spa, or enjoy the stunning mountain views from the outdoor hot tub.",
        icon: "hugeicons:wellness",
        iconClass: "bg-pink-500/10 text-pink-400",
      },
    ]}
    image={accom1}
    imageAlt="Community and Open Source"
    isReversed={true}
  >
    <Fragment>
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">
        Accommodation
      </h3>
      Stay in the most luxurious chalets chosen to provide the perfect environment
      for relaxation and recovery.
    </Fragment>
  </Content2>
</BaseLayout>
