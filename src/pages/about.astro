---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Content2 from "@/components/widgets/Content2.astro";
import Values from "@/components/widgets/Values.astro";
import teamImage from "@/assets/images/skiing/teamImage.jpg";

const metadata = {
  title: "About us",
  description:
    "Learn more about Alpine Edge and our mission to help you reach your potential as a skier.",
};

const values = [
  {
    title: "Excellence",
    description:
      "From our coaching to our accommodation, we strive for excellence in everything we do and seek to help our guests achieve the same.",
  },
  {
    title: "Innovation",
    description:
      "In blending elite coaching with exceptional comfort and care, we are changing a traditional ski camp into a refined luxury experience.",
  },
  {
    title: "Teamwork",
    description:
      "Teamwork is the cornerstone of Alpine Edge. We foster a collaborative environment where guests and instructors work together to achieve shared goals.",
  },
  {
    title: "Passion",
    description:
      "Our passion for skiing and commitment to our guests' success drives everything we do at Alpine Edge.",
  },
  {
    title: "Community",
    description:
      "Become part of a vibrant community of like-minded skiers who share your passion for progression and performance.",
  },
];
---

<BaseLayout {metadata}>
  <Content2
    title="Who We Are"
    description={[
      "Alpine Edge is a new and distinctive ski performance retreat, redefining the traditional ski camp into a refined luxury experience, hosted in the world-class resort of Val d’Isère.",
      "Designed for skiers seeking progression of the highest level, Alpine Edge blends elite coaching with exceptional comfort and care.",
      "<br/><br/>The week features fully immersive ski clinics led by our highly experienced, industry-leading instructors.",
      "Renowned for their technical mastery and personalised approach, they deliver in-depth on-piste coaching with real-time, one-to-one feedback, complemented by evening video analysis to accelerate your development.",
      "<br/><br/>Performance extends beyond the slopes. Our programme includes dedicated mobility and recovery sessions to support optimal movement, resilience, and overall wellbeing.",
      "Guests will benefit from targeted mobility classes, ice baths, hot tubs and sauna. Completing the experience, our private chef will curate nourishing alpine cuisine — beautifully crafted to fuel both performance and recovery.",
    ]}
    tagline="About"
    image={teamImage}
    imageAlt="The two coaches for Alpine Edge greeting each other on the mountain in Val d'Isere, France"
  />
  <Values
    items={values}
    columns={3}
    tagline="Our Values"
    title="What Defines Us"
  />
</BaseLayout>
